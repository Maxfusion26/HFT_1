<Window x:Class="BybitHftSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bybit HFT Suite" Height="900" Width="1400" MinHeight="720" MinWidth="1200"
        Background="#0B0F19" Foreground="#E5E7EB">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
    <SolidColorBrush x:Key="CardBrush" Color="#111827" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />

    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#0B0F19" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="24">
        <TextBlock Text="Bybit HFT Suite" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="C# WPF Migration" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20" />

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Connection" FontWeight="SemiBold" />
            <TextBlock Text="Status" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="Disconnected" Name="ConnectionStatus" Foreground="#FBBF24" FontSize="14" Margin="0,0,0,12" />
            <Button Content="Connect" Click="OnConnectClick" />
            <Button Content="Disconnect" Background="#475569" Click="OnDisconnectClick" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel>
            <TextBlock Text="Quick Actions" FontWeight="SemiBold" />
            <TextBlock Text="Manual" Foreground="{StaticResource MutedTextBrush}" />
            <Button Content="Send Buy" Click="OnManualBuyClick" />
            <Button Content="Send Sell" Background="{StaticResource DangerBrush}" Click="OnManualSellClick" />
            <Button Content="Flatten" Background="#475569" Click="OnFlattenClick" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Trading workspace" FontSize="24" FontWeight="Bold" />
          <TextBlock Text="Unified overview for Bybit futures execution" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Name="AutoTradingToggle" Content="Auto Trading" />
          <CheckBox Name="SimModeToggle" Content="Simulation Mode" />
        </StackPanel>
      </Grid>

      <TabControl Grid.Row="1">
        <TabItem Header="Overview">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock Text="Equity" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="--" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Updated on connect" Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,12,0">
                  <StackPanel>
                    <TextBlock Text="Open Positions" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="0" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Max 5" Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Latency" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="-- ms" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Server time sync" Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                  <StackPanel>
                    <TextBlock Text="Live Positions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#0B1220" Foreground="#F3F4F6" BorderBrush="{StaticResource BorderBrush}">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Width="*" Binding="{Binding Symbol}" />
                        <DataGridTextColumn Header="Side" Width="*" Binding="{Binding Side}" />
                        <DataGridTextColumn Header="Size" Width="*" Binding="{Binding Size}" />
                        <DataGridTextColumn Header="Entry" Width="*" Binding="{Binding Entry}" />
                        <DataGridTextColumn Header="Unrealized PnL" Width="*" Binding="{Binding Pnl}" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                  <StackPanel>
                    <TextBlock Text="Strategy Health" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Mode" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Adaptive Market Maker" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Risk limits" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Default" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Last sync: No sync yet" Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Configuration">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                  <TextBlock Text="API &amp; Session" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                  <Label Content="API Key" />
                  <TextBox Name="ApiKeyInput" />
                  <Label Content="API Secret" />
                  <TextBox Name="ApiSecretInput" />
                  <Label Content="Base URL" />
                  <TextBox Name="BaseUrlInput" Text="https://api.bybit.com" />
                  <Label Content="Position Mode" />
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="One-way" />
                    <ComboBoxItem Content="Hedge" />
                  </ComboBox>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Order Defaults" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Content="Order Type" />
                    <ComboBox SelectedIndex="0">
                      <ComboBoxItem Content="Market" />
                      <ComboBoxItem Content="Limit" />
                    </ComboBox>
                    <Label Content="Base Position Size (USDT)" />
                    <TextBox Text="20" />
                    <Label Content="Max Concurrent Positions" />
                    <TextBox Text="5" />
                    <CheckBox Content="Auto-shift limit price" IsChecked="True" />
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                  <StackPanel>
                    <TextBlock Text="TP/SL &amp; Fees" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Content="Take Profit (%)" />
                    <TextBox Text="0.35" />
                    <Label Content="Stop Loss (%)" />
                    <TextBox Text="0.2" />
                    <Label Content="Maker Fee (%)" />
                    <TextBox Text="0.01" />
                    <Label Content="Taker Fee (%)" />
                    <TextBox Text="0.06" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Symbols">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="Refresh" Click="OnRefreshSymbolsClick" />
              <CheckBox Content="Auto-select top 5" IsChecked="True" />
              <CheckBox Content="Include favorites" />
            </StackPanel>
            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="#0B1220" Foreground="#F3F4F6" BorderBrush="{StaticResource BorderBrush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Width="*" Binding="{Binding Symbol}" />
                <DataGridTextColumn Header="Volatility" Width="*" Binding="{Binding Volatility}" />
                <DataGridTextColumn Header="Imbalance" Width="*" Binding="{Binding Imbalance}" />
                <DataGridTextColumn Header="24h Change" Width="*" Binding="{Binding Change}" />
                <DataGridTextColumn Header="Score" Width="*" Binding="{Binding Score}" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <TabItem Header="Logs">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="Clear" Background="#475569" Click="OnClearLogsClick" />
              <Button Content="Export" Background="#475569" Click="OnExportLogsClick" />
            </StackPanel>
            <TextBox Grid.Row="1" Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" />
          </Grid>
        </TabItem>

        <TabItem Header="Backtest">
          <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="Run Simulation" Click="OnRunBacktestClick" />
              <TextBlock Text="Fee buffer: 0.08%" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <TextBlock Text="Backtest dashboard placeholder. PnL charts will be rendered here." Foreground="{StaticResource MutedTextBrush}" />
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
