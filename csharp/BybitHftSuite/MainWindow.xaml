<Window x:Class="BybitHftSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bybit HFT Suite" Height="900" Width="1300" MinHeight="700" MinWidth="1100"
        Background="#111827" Foreground="#F3F4F6">
  <Window.Resources>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,16" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="BorderBrush" Value="#374151" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="#F9FAFB" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,12,8" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#374151" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="Foreground" Value="#F9FAFB" />
      <Setter Property="BorderBrush" Value="#374151" />
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Bybit HFT Suite" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="UI prototype (C# WPF)" Margin="16,6,0,0" Foreground="#9CA3AF" />
    </StackPanel>

    <TabControl Grid.Row="1" Background="#0F172A" BorderBrush="#1F2937">
      <TabItem Header="Connection">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
              <GroupBox Header="API Credentials">
                <StackPanel>
                  <TextBlock Text="API Key" />
                  <TextBox Name="ApiKeyInput" />
                  <TextBlock Text="API Secret" />
                  <TextBox Name="ApiSecretInput" />
                  <TextBlock Text="Base URL" />
                  <TextBox Name="BaseUrlInput" Text="https://api.bybit.com" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Connection Controls">
                <StackPanel>
                  <WrapPanel>
                    <Button Content="Connect" Click="OnConnectClick" />
                    <Button Content="Disconnect" Background="#6B7280" Click="OnDisconnectClick" />
                  </WrapPanel>
                  <WrapPanel>
                    <CheckBox Name="AutoTradingToggle" Content="Auto Trading" />
                    <CheckBox Name="SimModeToggle" Content="Sim Mode" />
                  </WrapPanel>
                  <TextBlock Text="Connection status: Disconnected" Name="ConnectionStatus" Foreground="#FBBF24" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <GroupBox Header="Session">
                <StackPanel>
                  <TextBlock Text="Account" />
                  <TextBox Text="UNIFIED" IsReadOnly="True" />
                  <TextBlock Text="Position Mode" />
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="One-way" />
                    <ComboBoxItem Content="Hedge" />
                  </ComboBox>
                  <TextBlock Text="Risk Limits" />
                  <TextBox Text="Default" IsReadOnly="True" />
                  <TextBlock Text="Last sync: No sync yet" Foreground="#9CA3AF" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Status">
                <StackPanel>
                  <TextBlock Text="Latency" />
                  <TextBox Text="-- ms" IsReadOnly="True" />
                  <TextBlock Text="Server time" />
                  <TextBox Text="--" IsReadOnly="True" />
                  <TextBlock Text="Warnings" />
                  <TextBox Text="None" IsReadOnly="True" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Trading Controls">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
              <GroupBox Header="Order Defaults">
                <StackPanel>
                  <TextBlock Text="Order Type" />
                  <ComboBox SelectedIndex="0">
                    <ComboBoxItem Content="Market" />
                    <ComboBoxItem Content="Limit" />
                  </ComboBox>
                  <TextBlock Text="Base Position Size (USDT)" />
                  <TextBox Text="20" />
                  <TextBlock Text="Max Concurrent Positions" />
                  <TextBox Text="5" />
                  <CheckBox Content="Auto-shift limit price" IsChecked="True" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="TP/SL Controls">
                <StackPanel>
                  <TextBlock Text="Take Profit (%)" />
                  <TextBox Text="0.35" />
                  <TextBlock Text="Stop Loss (%)" />
                  <TextBox Text="0.2" />
                  <TextBlock Text="Maker Fee (%)" />
                  <TextBox Text="0.01" />
                  <TextBlock Text="Taker Fee (%)" />
                  <TextBox Text="0.06" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <GroupBox Header="Strategy Inputs">
                <StackPanel>
                  <TextBlock Text="Imbalance Skew" />
                  <TextBox Text="0.6" />
                  <TextBlock Text="Volatility Threshold" />
                  <TextBox Text="1.2" />
                  <TextBlock Text="Momentum Weight" />
                  <TextBox Text="0.5" />
                  <TextBlock Text="Entry Score" />
                  <TextBox Text="3.5" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Manual Actions">
                <WrapPanel>
                  <Button Content="Send Buy" Click="OnManualBuyClick" />
                  <Button Content="Send Sell" Background="#DC2626" Click="OnManualSellClick" />
                  <Button Content="Flatten" Background="#6B7280" Click="OnFlattenClick" />
                </WrapPanel>
                <TextBlock Foreground="#9CA3AF" Text="Manual order actions are stubbed until trading logic is ported." />
              </GroupBox>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Symbols">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Refresh" Click="OnRefreshSymbolsClick" />
            <CheckBox Content="Auto-select top 5" IsChecked="True" />
            <CheckBox Content="Include favorites" />
          </WrapPanel>
          <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#0B1220" Foreground="#F3F4F6" BorderBrush="#1F2937">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Symbol" Width="*" Binding="{Binding Symbol}" />
              <DataGridTextColumn Header="Volatility" Width="*" Binding="{Binding Volatility}" />
              <DataGridTextColumn Header="Imbalance" Width="*" Binding="{Binding Imbalance}" />
              <DataGridTextColumn Header="24h Change" Width="*" Binding="{Binding Change}" />
              <DataGridTextColumn Header="Score" Width="*" Binding="{Binding Score}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Portfolio">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Equity: --" Margin="0,0,16,0" />
            <TextBlock Text="Available Balance: --" Margin="0,0,16,0" />
            <TextBlock Text="Open Positions: 0" />
          </WrapPanel>
          <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                    Background="#0B1220" Foreground="#F3F4F6" BorderBrush="#1F2937">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Symbol" Width="*" Binding="{Binding Symbol}" />
              <DataGridTextColumn Header="Side" Width="*" Binding="{Binding Side}" />
              <DataGridTextColumn Header="Size" Width="*" Binding="{Binding Size}" />
              <DataGridTextColumn Header="Entry" Width="*" Binding="{Binding Entry}" />
              <DataGridTextColumn Header="Unrealized PnL" Width="*" Binding="{Binding Pnl}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <TabItem Header="Logs">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Clear" Background="#6B7280" Click="OnClearLogsClick" />
            <Button Content="Export" Background="#6B7280" Click="OnExportLogsClick" />
          </WrapPanel>
          <TextBox Grid.Row="1" Name="LogOutput" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Background="#0B1220" BorderBrush="#1F2937" />
        </Grid>
      </TabItem>

      <TabItem Header="Backtest">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Run Simulation" Click="OnRunBacktestClick" />
            <TextBlock Text="Fee buffer: 0.08%" Foreground="#9CA3AF" />
          </WrapPanel>
          <Border Grid.Row="1" Background="#0B1220" BorderBrush="#1F2937" BorderThickness="1" Padding="16">
            <TextBlock Text="Backtest dashboard placeholder. PnL charts will be rendered here." Foreground="#9CA3AF" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
